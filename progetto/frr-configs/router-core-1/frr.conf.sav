frr version 10.7.1
frr defaults traditional
hostname router-core-1
domainname localdomain
no ipv6 forwarding
agentx
!
interface eth1
 description "connects to router-core-2 eth2"
 ip address 172.20.1.1/30
 ip ospf network point-to-point
exit
!
interface eth2
 ip address 172.20.2.1/30
 ip ospf network point-to-point
exit
!
interface eth3
 ip address 172.30.111.1/24
exit
!
interface eth4
 ip address 172.30.211.1/24
exit
!
interface lo1
 ip address 192.168.0.1/32
exit
!
router ospf
 ospf router-id 1.1.1.1
 redistribute connected
 network 172.20.0.0/16 area 0
 network 172.30.111.0/24 area 0
 network 172.30.211.0/24 area 0
exit
!
