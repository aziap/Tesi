frr version 10.7.1
frr defaults traditional
hostname router-1-2
domainname localdomain
no ipv6 forwarding
!
interface eth1
 ip address 172.16.1.2/24
exit
!
interface eth2
 ip address 172.30.122.12/24
exit
!
interface lo
 ip address 10.1.12.1/32
 ip ospf passive
exit
!
interface lo1
 ip address 192.168.1.2/32
exit
!
router ospf
 ospf router-id 4.4.4.4
 redistribute connected
 network 172.16.1.0/24 area 1
 network 172.30.122.0/24 area 0
exit
!
