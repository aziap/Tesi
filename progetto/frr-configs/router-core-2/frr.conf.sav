frr version 10.7.1
frr defaults traditional
hostname router-core-2
domainname localdomain
no ipv6 forwarding
agentx
!
interface eth1
 ip address 172.20.1.2/30
 ip ospf network point-to-point
exit
!
interface eth2
 ip address 172.20.2.2/30
 ip ospf network point-to-point
exit
!
interface eth3
 ip address 172.30.122.2/24
exit
!
interface eth4
 ip address 172.30.222.2/24
exit
!
interface lo1
 ip address 192.168.0.2/32
exit
!
router ospf
 ospf router-id 2.2.2.2
 redistribute connected
 network 172.20.0.0/16 area 0
 network 172.30.122.0/24 area 0
 network 172.30.222.0/24 area 0
 network 192.168.0.2/32 area 0
exit
!
