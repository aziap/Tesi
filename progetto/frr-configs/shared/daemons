# FRR daemons configuration for frr_exporter testing
# Enable all daemons needed by collectors

zebrad=yes
bgpd=no
ospfd=yes
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

# SNMP daemon
snmpd=yes

# Integrated config mode
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000 -M snmp"
bgpd_options="   -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1 -M snmp"
pimd_options="   -A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
vrrpd_options="  -A 127.0.0.1"
